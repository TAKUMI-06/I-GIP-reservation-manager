# ==============================================================
# i-GIP 入館管理システム - 環境変数サンプル
# コピーして .env.local を作成し、実際の値を設定してください。
# ==============================================================

# --- Supabase ---
# Supabaseプロジェクト設定 > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Service Roleキー（サーバー専用・絶対にクライアントへ露出しない）
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- メール送信（Gmail SMTP）---
# 送信に使うGmailアドレス
GMAIL_USER=igipkanto2026@gmail.com
# Googleアカウントの「アプリ パスワード」（2段階認証を有効化した上で発行）
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# 送信者表示名（任意）
MAIL_FROM_NAME=i-GIP 入館管理

# --- アプリ設定 ---
# 本番URL（QRコードURLの生成やメール内リンクに使用）
NEXT_PUBLIC_APP_URL=https://i-gip.example.jp

# 前日リマインド・データ保持バッチ等を保護するシークレット
# Vercel Cron からのリクエストヘッダー(Authorization: Bearer <値>)と一致させる
CRON_SECRET=change-this-to-a-long-random-string

# 管理者への新規予約通知の送信先（未設定時はnotification_settingsテーブルを参照）
ADMIN_NOTIFICATION_EMAIL=admin@your-domain.jp
